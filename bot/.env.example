# ══════════════════════════════════════════════════════════════════════
#  Draxo Bot — Konfiguration
#  Kopieren:   cp .env.example .env
#  Danach:     nano .env     (chmod 600 nicht vergessen)
#  Diese Datei gehört NIE ins Git.
# ══════════════════════════════════════════════════════════════════════

# ── Pflicht ──────────────────────────────────────────────────────────
# Developer Portal → deine Application → Bot → „Reset Token“ → kopieren.
DISCORD_TOKEN=HIER_DEIN_BOT_TOKEN

# Für Grants wird außerdem DRAXO_SIGNING_KEY gebraucht (siehe unten).

# ── Server ───────────────────────────────────────────────────────────
# Server-ID: Rechtsklick auf den Servernamen → „Server-ID kopieren“
#            (in den Nutzereinstellungen aktivieren, falls nicht sichtbar).
# Ohne diese ID werden Slash-Commands global verteilt — das kann bis zu
# einer Stunde dauern. Mit ID sind sie sofort da.
DISCORD_GUILD_ID=1534959905104986314

# Channel, in dem das Willkommens-Panel steht und neue Mitglieder begrüßt
# werden. Rechtsklick auf den Channel → „ID kopieren“.
WELCOME_CHANNEL_ID=

# Optional: Channel, in das jede Key-Ausstellung protokolliert wird.
# Sinnvoll für Moderation und Missbrauchserkennung.
LOG_CHANNEL_ID=

# Optional: Rolle, die neue Mitglieder automatisch bekommen.
# Die Rolle muss in der Rollenliste ÜBER der „Bot“-Rolle stehen.
MEMBER_ROLE_ID=

# ── Verhalten ────────────────────────────────────────────────────────
# Beim Beitritt begrüßen. Braucht den privilegierten „Server-Mitglieder
# an Intent“, der im Developer Portal unter Bot → Privileged Intents
# aktiviert sein muss. Auf 0 stellen, wenn das nicht möglich ist.
WELCOME_ON_JOIN=1

# Aktivität in der Mitgliederliste
ACTIVITY_TEXT=Draxo Client | FREE

LOG_LEVEL=INFO

# ── Grant-Ausgabe (Ed25519) ───────────────────────────────────────────
# Der private Schluessel. Er bleibt auf diesem Server und kommt in keine
# EXE, auf keine Website und ins Git. Einmalig erzeugen mit:
#
#   python -m draxo_bot.signing keygen
#
# Der oeffentliche Teil muss in license_signing.py als
# SERVER_PUBLIC_KEY_HEX stehen — dort ist er fest eingebaut, damit der
# Launcher offline pruefen kann, ohne erst den Server zu fragen.
#
# Stimmen die beiden nicht ueberein, stellt der Bot Grants aus, die der
# Client zurueckweist. Beim Start meldet der Bot das im Log.
DRAXO_SIGNING_KEY=

# Gueltigkeit eines Grants in Stunden (max. 720 = 30 Tage)
KEY_HOURS=24

# Grants pro Nutzer und Tag
KEY_MAX_PER_DAY=1

# Grant zusaetzlich an den Rechner binden. Aus = der Grant gilt auf jedem
# Rechner, auf dem derselbe Discord-Login benutzt wird.
BIND_HWID=1

# Ablage von HWIDs, Rate-Limits und Widerrufen
DRAXO_DB=./data/draxo.sqlite3

# ── HTTP-API (Mint + Pruefen) ────────────────────────────────────────
# Diese API erledigt drei Aufgaben:
#
#   /api/v1/issue   Grants ausstellen — aufgerufen von der Netlify-Funktion
#   /api/v1/verify  Pruefen, ob ein Grant noch gilt — aufgerufen vom Launcher
#   /api/v1/hwid    Hinterlegte HWID lesen und schreiben
#
# Ohne /api/v1/verify laeuft alles, nur ein gesperrter Grant wirkt erst
# nach seinem Ablauf. Ohne /api/v1/issue laeuft der Bot nur ueber das
# Gateway — dann aber nicht ueber die Netlify-Funktion.
#
# API_ENABLED=1 verlangt API_TOKEN. Ohne Token bricht der Bot mit einer
# Fehlermeldung ab, statt einen offenen Lizenzserver zu starten.
#
# Hinter einem Reverse-Proxy (Caddy/nginx mit TLS) betreiben und API_BIND
# auf 127.0.0.1 lassen — der Token im Klartext gehört nicht ins Netz.
API_ENABLED=1
API_BIND=127.0.0.1
API_PORT=8787
API_TOKEN=

# ── Netlify-Funktion (Interactions-Endpoint) ──────────────────────────
# Nur noetig, wenn Slash-Commands ueber die Netlify-Funktion laufen sollen
# statt ueber das Gateway.
#
# Die Funktion bekommt NIE den privaten Schluessel. Sie holt sich Grants
# ueber API_TOKEN von diesem Server — sonst laege DRAXO_SIGNING_KEY als
# Netlify-Secret vor, und jeder, der den Account deployen darf, koennte
# beliebige Keys ausstellen.
#
# In Netlify (Site settings → Environment variables) eintragen:
#   DISCORD_PUBLIC_KEY  aus General Information der Application
#   DRAXO_MINT_URL      oeffentliche Adresse dieses Servers, z. B.
#                       https://bot.example.com   (ohne /api/v1)
#   DRAXO_MINT_TOKEN    derselbe Wert wie API_TOKEN hier